# Copy to .env. For local Python commands, load it with uv run --env-file .env.

# Discord Developer Portal > Bot > Token (not the Client Secret).
DISCORD_BOT_TOKEN=

# Discord User ID of the only authorized user (not the Application ID).
DISCORD_OWNER_ID=

# Optional; defaults to gpt-6-luna.
# CODEX_MODEL=gpt-6-luna

# Codex uses OAuth; no API key or OAuth token belongs in this file.
